{
  "manifest_version": 3,
  "name": "PackeTech · открыть сайт",
  "version": "0.3.2",
  "key": "",
  "description": "Добавляет текущий сайт в маршруты WireGuard и запоминает источник Chrome.",
  "permissions": ["activeTab", "storage", "nativeMessaging"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Открыть сайт через VPN"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
