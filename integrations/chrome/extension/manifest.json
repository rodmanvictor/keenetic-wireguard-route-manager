{
  "manifest_version": 3,
  "name": "Keenetic · открыть сайт",
  "version": "0.2.1",
  "description": "Добавляет текущий сайт в маршруты srv01 и запоминает источник Chrome.",
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Открыть сайт через srv01"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
